*.pyc
.pytest_cache/
.env
*.key
*.zip
*.gguf
*.onnx
demo_out/

# runtime directories: keep the folder, ignore the content
data/*
!data/.gitkeep
models/*
!models/.gitkeep
logs/*
!logs/.gitkeep
receipts/*
!receipts/.gitkeep

